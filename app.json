{
  "expo": {
    "name": "curso-seminario",
    "slug": "curso-seminario",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cursoseminario",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para mostrarla en el mapa."
      },
      "config": {
        "googleMaps": {
            "apiKey": "AIzaSyCqVQzuVUbELF4XetnH344Vnup0oWilKHw"
        }
      }
    },
    "android": {
      "permissions": [
       "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff",
        "config": {
        "googleMaps": {
            "apiKey": "AIzaSyCqVQzuVUbELF4XetnH344Vnup0oWilKHw"
        }
      }
      },
      "edgeToEdgeEnabled": true,
      "package": "com.smerling.cursoseminario"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite que la app acceda a tu ubicación para el rastreo."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "95c87c2b-a2a6-41c1-a239-cdee2ac2725e"
      }
    }
  }
}